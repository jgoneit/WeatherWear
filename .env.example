# WeatherWear 환경 변수 예시. 이 파일을 `.env`로 복사해 사용한다.
# 우선순위: 프로세스 환경 변수 > .env > 아래 기본값.

# Google Cloud Agent Platform express mode API 키. Google AI Studio 키로는 동작하지 않는다.
# VISION_PROVIDER=gemini일 때만 필요하다. 프로젝트 ID와 위치는 필요 없다.
# express mode 콘솔(APIs & Services > Credentials)에서 받은 키를 .env에 넣고, 실제 값을 이 파일에 커밋하지 않는다. (기본값: 빈 값)
GEMINI_API_KEY=

# Vision 분석 제공자: fixture(API 키 없이 사전 정의 결과) 또는 gemini(Agent Platform express mode로 Gemini 호출). (기본값: fixture)
VISION_PROVIDER=fixture

# VISION_PROVIDER=gemini일 때 Agent Platform express mode로 호출할 Gemini 모델 ID. (기본값: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# 날씨 제공자: fixture(고정 fixture 날씨) 또는 open_meteo(Open-Meteo Archive API, 키 불필요). (기본값: fixture)
WEATHER_PROVIDER=fixture

# SQLite 데이터베이스 URL. 부모 디렉터리가 없으면 기동 시 만든다. (기본값: sqlite:///./data/weatherwear.db)
DATABASE_URL=sqlite:///./data/weatherwear.db

# 스캔할 사진 폴더. 최상위의 .jpg/.jpeg/.png/.webp를 읽고, 촬영 시각·위치는 사진 내장 EXIF 메타데이터에서 읽는다.
# 같은 이름의 *.metadata.json(선택)은 시드 투표나 내장 메타데이터가 없을 때의 대체 출처로 쓴다. (기본값: ./data/demo/photos)
PHOTO_DIR=./data/demo/photos

# 날짜·시각 표시와 Open-Meteo 조회에 쓰는 IANA 타임존. (기본값: Asia/Seoul)
APP_TIMEZONE=Asia/Seoul

# 유사 기온 판정 허용 오차(°C). 0 초과 5.0 미만, 비우면 3.0. (기본값: 3)
TEMPERATURE_TOLERANCE_C=3

# 오늘 날씨 조회 위도(-90~90). (기본값: 37.5665, 서울)
DEFAULT_LATITUDE=37.5665

# 오늘 날씨 조회 경도(-180~180). (기본값: 126.9780, 서울)
DEFAULT_LONGITUDE=126.9780

# CORS 허용 출처 목록. 쉼표로 구분하고 각 항목의 앞뒤 공백은 제거된다. (기본값: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# 프론트엔드가 호출할 백엔드 API 기본 URL. 프론트엔드(Vite)만 읽는다. (기본값: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# --- Phase 2 자동화 (갤러리 감시, 매일 브리핑, 알림) ---

# 갤러리 폴더 감시 사용 여부(true/false/1/0/yes/no/on/off). 코드 기본값은 false이고, 이 예시는 데모를 위해 켜 둔다. (기본값: false)
GALLERY_WATCH_ENABLED=true

# 감시할 갤러리 폴더. `ex_img/`를 휴대폰 갤러리로 본다. 처음 감시를 시작할 때 이미 있던 사진은 기준선으로만 기록한다. (기본값: ./ex_img)
GALLERY_DIR=./ex_img

# 갤러리 폴더를 확인하는 간격(초). 0.5 이상 60 이하. (기본값: 2)
GALLERY_POLL_SECONDS=2

# 감시로 가져온 사진의 복사본을 두는 폴더. PHOTO_DIR, GALLERY_DIR와 같거나 서로 포함하면 안 된다. (기본값: ./data/user/photos)
USER_PHOTO_DIR=./data/user/photos

# 매일 착장 브리핑 사용 여부(true/false/1/0/yes/no/on/off). 코드 기본값은 false이고, 이 예시는 데모를 위해 켜 둔다. (기본값: false)
DAILY_BRIEF_ENABLED=true

# 매일 브리핑 시각. APP_TIMEZONE 기준 24시간 HH:MM. (기본값: 07:30)
DAILY_BRIEF_TIME=07:30

# 알림 전달 방식: log(오프라인, 알림 기록만 남김) 또는 webpush(표준 Web Push, VAPID). (기본값: log)
NOTIFIER=log

# VAPID 키 쌍을 저장하는 폴더. 개인키가 저장되므로 커밋하지 않는다(.gitignore에 data/secrets/ 포함). (기본값: ./data/secrets)
VAPID_KEY_DIR=./data/secrets

# Web Push 발신자 연락처. mailto: 또는 https://로 시작한다. (기본값: mailto:weatherwear@example.com)
VAPID_SUBJECT=mailto:weatherwear@example.com
