*.key

# Local database
data/weatherwear.db*

# Photos (not published; prepare locally with scripts/prepare_demo_photos.py)
# Demo photos (people photos, ~290MB): copy to the deploy server separately.
# ex_img/ also holds files whose usage rights are not confirmed.
# Sidecar metadata JSON files stay tracked.
ex_img/
data/demo/photos/*
!data/demo/photos/*.metadata.json

# Python
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/

# Node / build
node_modules/
dist/
build/
.next/
out/

# OS
.DS_Store

# Editor / logs
.vscode/
.idea/
*.log

# Evaluation outputs (generated)
eval-results/

