# WeatherWear 환경 변수 예시. 이 파일을 `.env`로 복사해 사용한다.
# 우선순위: 프로세스 환경 변수 > .env > 아래 기본값.

# Gemini API 키. VISION_PROVIDER=gemini일 때만 필요하다. 실제 값을 이 파일에 커밋하지 않는다. (기본값: 빈 값)
GEMINI_API_KEY=

# Vision 분석 제공자: fixture(API 키 없이 사전 정의 결과) 또는 gemini(Gemini API 호출). (기본값: fixture)
VISION_PROVIDER=fixture

# VISION_PROVIDER=gemini일 때 호출할 Gemini 모델 ID. (기본값: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# 날씨 제공자: fixture(고정 fixture 날씨) 또는 open_meteo(Open-Meteo Archive API, 키 불필요). (기본값: fixture)
WEATHER_PROVIDER=fixture

# SQLite 데이터베이스 URL. 부모 디렉터리가 없으면 기동 시 만든다. (기본값: sqlite:///./data/weatherwear.db)
DATABASE_URL=sqlite:///./data/weatherwear.db

# 스캔할 사진 폴더. 최상위의 .jpg/.jpeg/.png/.webp와 같은 이름의 *.metadata.json을 읽는다. (기본값: ./data/demo/photos)
PHOTO_DIR=./data/demo/photos

# 날짜·시각 표시와 Open-Meteo 조회에 쓰는 IANA 타임존. (기본값: Asia/Seoul)
APP_TIMEZONE=Asia/Seoul

# 유사 기온 판정 허용 오차(°C). 0 초과 5.0 미만, 비우면 3.0. (기본값: 3)
TEMPERATURE_TOLERANCE_C=3

# 오늘 날씨 조회 위도(-90~90). (기본값: 37.5665, 서울)
DEFAULT_LATITUDE=37.5665

# 오늘 날씨 조회 경도(-180~180). (기본값: 126.9780, 서울)
DEFAULT_LONGITUDE=126.9780

# CORS 허용 출처 목록. 쉼표로 구분하고 각 항목의 앞뒤 공백은 제거된다. (기본값: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# 프론트엔드가 호출할 백엔드 API 기본 URL. 프론트엔드(Vite)만 읽는다. (기본값: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
